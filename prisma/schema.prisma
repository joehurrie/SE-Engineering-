// Prisma Schema for Specialized Engineering Kenya Ltd.
// Database: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String // Hashed via bcrypt
  name      String
  role      String   @default("EDITOR") // SUPER_ADMIN, EDITOR
  createdAt DateTime @default(now())
}

model SiteContent {
  id          Int      @id @default(autoincrement())
  sectionKey  String   @unique // e.g., 'home_hero', 'about_intro', 'contact_info'
  title       String?
  subtitle    String?
  bodyText    String? // Rich text or markdown
  imageUrl    String? // Cloud storage link
  contentJson String?
  updatedAt   DateTime @updatedAt
}

model ElevatorProduct {
  id             Int      @id @default(autoincrement())
  category       String // Elevator product category
  title          String
  description    String
  specifications String?
  imageUrl       String
  galleryImages  String[] @default([])
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model SparePartProduct {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  title          String
  description    String
  specifications String?
  imageUrl       String
  galleryImages  String[] @default([])
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model LiftService {
  id          Int     @id @default(autoincrement())
  category    String // "Spare Parts", "Lift Modernization", "Solution Customization"
  title       String
  description String
  imageUrl    String?
}

model Project {
  id            Int      @id @default(autoincrement())
  projectName   String
  projectType   String
  description   String   @default("")
  elevatorCount Int
  location      String?
  latitude      Float?
  longitude     Float?
  imageUrl      String
  galleryImages String[] @default([])
  status        String   @default("COMMISSIONED")
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model NewsArticle {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String
  imageUrl    String?
  publishedAt DateTime @default(now())
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model JobVacancy {
  id             Int              @id @default(autoincrement())
  title          String
  department     String           @default("Engineering")
  location       String
  employmentType String
  description    String
  requirements   String
  published      Boolean          @default(false)
  applications   JobApplication[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model JobApplication {
  id           Int         @id @default(autoincrement())
  vacancyId    Int?
  vacancyTitle String
  name         String
  email        String
  phone        String
  resumeUrl    String
  portfolioUrl String?
  message      String
  consentAt    DateTime    @default(now())
  status       String      @default("NEW")
  createdAt    DateTime    @default(now())
  vacancy      JobVacancy? @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
}
