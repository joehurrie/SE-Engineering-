// Prisma Schema for Specialized Engineering Kenya Ltd.
// Database: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Hashed via bcrypt
  name      String
  role      String   @default("EDITOR") // SUPER_ADMIN, EDITOR
  createdAt DateTime @default(now())
}

model SiteContent {
  id          Int      @id @default(autoincrement())
  sectionKey  String   @unique // e.g., 'home_hero', 'about_intro', 'contact_info'
  title       String?
  subtitle    String?
  bodyText    String?  // Rich text or markdown
  imageUrl    String?  // Cloud storage link
  updatedAt   DateTime @updatedAt
}

model ElevatorProduct {
  id             Int      @id @default(autoincrement())
  category       String   // "Home Lift", "Passenger Elevator", "Escalator & Moving Walk", "Panoramic Elevator", "Hospital Elevator", "Freight Elevator & Car Elevator", "Dumbwaiter", "Hydraulic Platform"
  title          String
  description    String
  specifications String?
  imageUrl       String
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model LiftService {
  id          Int      @id @default(autoincrement())
  category    String   // "Spare Parts", "Lift Modernization", "Solution Customization"
  title       String
  description String
  imageUrl    String?
}

model Project {
  id            Int      @id @default(autoincrement())
  projectName   String
  projectType   String
  elevatorCount Int
  location      String?
  imageUrl      String
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model NewsArticle {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String
  imageUrl    String?
  publishedAt DateTime @default(now())
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}
